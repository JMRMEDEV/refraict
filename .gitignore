# Local tests
e2e-test/*

# Ignore .libreq directory contents (libreq tooling state — not part of the project)
.libreq/

# Kiro agent config (local tooling state — not part of the project)
.kiro/

# libreq chat logs
libreq-chat-*.txt

# Cache
.refraict-cache
.refraict-cache.sqlite

# Executables & Binaries
# Commonly used output directories when using 'go build -o bin/' or scripts
bin/
dist/

# Raw binaries (matching root executable names or OS outputs)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries produced by `go test -c`
*.test

# Output of 'go build' if built directly in the root directory without -o
# (Replace 'app' with your project's main binary name if applicable)
/app

# Go coverage / profiling outputs
*.out
*.prof
# Root-built binary from 'go build ./cmd/refraict'
/refraict
